# Copy to .env.local and fill in real values. .env.local is git-ignored.

# From @BotFather
TELEGRAM_BOT_TOKEN=""

# Random string you choose; passed to Telegram's setWebhook and validated on every
# incoming request via Telegraf's secretToken option.
TELEGRAM_WEBHOOK_SECRET=""

# Base URL of the .NET backend the bot forwards every inbound message to.
# The bot holds no state of its own — identity, cycle tracking, reminders,
# everything lives on that side.
BACKEND_API_BASE_URL=""

# Optional bearer token sent as `Authorization: Bearer <value>` on calls to
# BACKEND_API_BASE_URL, if the backend requires one.
BACKEND_API_KEY=""

# Random string shared with the .NET backend. Required on every call to this
# bot's POST /internal/notify (the "push" direction — e.g. a due reminder),
# checked against the x-push-secret header.
BACKEND_PUSH_SECRET=""

# Public HTTPS URL Telegram should deliver webhooks to (your ngrok/Cloudflare Tunnel
# URL in dev, your Railway URL in prod). Path is appended automatically.
PUBLIC_URL=""

PORT="3000"
